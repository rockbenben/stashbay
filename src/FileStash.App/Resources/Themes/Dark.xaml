<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The transit shelf keeps its silhouette against both white and black desktops. -->
    <SolidColorBrush x:Key="Brush.ShelfSurface" Color="#FF23272A" />
    <SolidColorBrush x:Key="Brush.ShelfBorder" Color="#FF5F686E" />
    <SolidColorBrush x:Key="Brush.ShelfText" Color="#FFF1F4F5" />
    <SolidColorBrush x:Key="Brush.ShelfSecondary" Color="#FFB5BDC2" />
    <SolidColorBrush x:Key="Brush.ShelfCard" Color="#FFE9EEED" />
    <SolidColorBrush x:Key="Brush.ShelfCardBack" Color="#FF3FC7AE" />
    <SolidColorBrush x:Key="Brush.ShelfHover" Color="#FF31373C" />

    <!--
        深色主题（温润石墨 + 克制品牌青绿）：
        只覆盖 Brush.* —— 键名与浅色一一对应，ThemeService 切换时直接换字典。
    -->

    <SolidColorBrush x:Key="Brush.Surface" Color="#FF151719" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF1C1F22" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="#FF101214" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="#FF22262A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF2A2E33" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#FF3C4249" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFEDF0F2" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFA2A9B0" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#FF8C939A" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF3FC7AE" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF52D1B9" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#FF172C29" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="#FF0D1514" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF4AD295" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#FF172D24" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFE0B04B" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FF2E2617" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#FFE5736D" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FF311C1C" />
    <SolidColorBrush x:Key="Brush.Selection" Color="#FF213130" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#FF23272B" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="#16FFFFFF" />

</ResourceDictionary>
