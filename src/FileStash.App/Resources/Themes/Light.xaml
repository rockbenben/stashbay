<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The transit shelf keeps its silhouette against both white and black desktops. -->
    <SolidColorBrush x:Key="Brush.ShelfSurface" Color="#FFECEFEF" />
    <SolidColorBrush x:Key="Brush.ShelfBorder" Color="#FF8C969A" />
    <SolidColorBrush x:Key="Brush.ShelfText" Color="#FF1B2022" />
    <SolidColorBrush x:Key="Brush.ShelfSecondary" Color="#FF4B5458" />
    <SolidColorBrush x:Key="Brush.ShelfCard" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.ShelfCardBack" Color="#FF189E89" />
    <SolidColorBrush x:Key="Brush.ShelfHover" Color="#FFDCE3E4" />

    <!--
        浅色主题（温润石墨 + 克制品牌青绿）：
        靠表面亮度差 + 发丝线分层，品牌青绿（#0C6E5F）只用于主按钮、焦点环、活动导航指示与拖拽高亮。
        所有文字与图标均满足 WCAG 2.2 AA 对比度门槛。
    -->

    <Color x:Key="Color.Surface">#FFF9FAFA</Color>
    <Color x:Key="Color.SurfaceAlt">#FFF1F3F4</Color>
    <Color x:Key="Color.SurfaceSunken">#FFE7EAEB</Color>
    <Color x:Key="Color.SurfaceElevated">#FFFFFFFF</Color>
    <Color x:Key="Color.Border">#FFD8DDDF</Color>
    <Color x:Key="Color.BorderStrong">#FFBAC2C6</Color>
    <Color x:Key="Color.TextPrimary">#FF181C1E</Color>
    <Color x:Key="Color.TextSecondary">#FF525A5F</Color>
    <Color x:Key="Color.TextTertiary">#FF626B71</Color>
    <Color x:Key="Color.Accent">#FF0C6E5F</Color>
    <Color x:Key="Color.AccentHover">#FF0A5D50</Color>
    <Color x:Key="Color.AccentSoft">#FFE4F4F1</Color>
    <Color x:Key="Color.AccentText">#FFFFFFFF</Color>
    <Color x:Key="Color.Success">#FF137352</Color>
    <Color x:Key="Color.SuccessSoft">#FFE5F5EE</Color>
    <Color x:Key="Color.Warning">#FF8F5F00</Color>
    <Color x:Key="Color.WarningSoft">#FFFBF1DA</Color>
    <Color x:Key="Color.Danger">#FFB4342D</Color>
    <Color x:Key="Color.DangerSoft">#FFFCEBE9</Color>
    <Color x:Key="Color.Selection">#FFE0F0ED</Color>
    <Color x:Key="Color.Hover">#FFE8ECEE</Color>
    <Color x:Key="Color.HoverOverlay">#12000000</Color>

    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="{StaticResource Color.SurfaceAlt}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Brush.SurfaceElevated" Color="{StaticResource Color.SurfaceElevated}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="{StaticResource Color.AccentSoft}" />
    <SolidColorBrush x:Key="Brush.AccentText" Color="{StaticResource Color.AccentText}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Hover" Color="{StaticResource Color.Hover}" />
    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="{StaticResource Color.HoverOverlay}" />

    <!-- 字体：拉丁走 Segoe UI Variable，中文回退到雅黑 UI；路径与数据用等宽 -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

    <!--
        字号一律不动：多语言长文案已经顶到槽位边界，
        放大字号会撑破视觉树探针的溢出检查。层级改由字重 / 灰度 / 留白表达。
    -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Caption">11</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Body">12.5</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Menu">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Title">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Font.Size.Display">20</sys:Double>

    <!-- 大圆角 + 药丸：卡片 / 面板 / 胶囊三种半径，控件内边距相应放大 -->
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
    <Thickness x:Key="Thickness.ControlPadding">12,6,12,6</Thickness>
    <Thickness x:Key="Thickness.RowPadding">12,0,12,0</Thickness>

</ResourceDictionary>
