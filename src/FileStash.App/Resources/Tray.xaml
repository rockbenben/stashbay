<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="http://www.hardcodet.net/taskbar"
                    xmlns:app="clr-namespace:FileStash.App.Resources">

    <!--
        放在资源字典里的 TaskbarIcon 不会进入可视树，
        H.NotifyIcon 的 Loaded 事件永远不触发 → 必须在代码里手动 ForceCreate()。
        Windows 将图标 GUID 绑定到可执行文件路径，使用 H.NotifyIcon 按路径生成的默认 Id。
    -->
    <h:TaskbarIcon x:Key="Tray"
                    ToolTipText="{x:Static app:Strings.AppName}" />

</ResourceDictionary>
