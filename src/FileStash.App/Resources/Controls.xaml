<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
        控件样式。视觉语言：中性石墨（无彩色相）、大圆角、发丝线分层、
        粗体大字配灰色说明。规则：
        · 颜色一律走 DynamicResource（换主题时才跟得上）；
        · 具名 Style 必须显式 BasedOn —— 具名 Style 不会自动继承隐式样式，漏了 BasedOn
          按钮会掉光配色变成系统默认的灰按钮，而且**不报错**；
        · 文字的默认色挂在 Window 上（继承），**不挂在隐式 TextBlock 样式上**：
          挂在样式上会盖过按钮自己的前景色，主键就变成"深字压强调色"（实测 1.78:1）；
          样式里凡是具名 TextBlock 样式都得自带 Foreground，不然它掉回系统黑；
        · 带 TextTrimming 的 TextBlock 不加 MinWidth（会把截断主体从 TextBlock 变成父容器裁剪，
          右到左布局下切掉的是字符串开头且没有省略号）；
        · 圆角与内边距走 Radius.* / Thickness.* token（见 Light.xaml），不再写死 3px；
          药丸用 Radius.Pill，面板用 Radius.Panel，控件用 Radius.Control；
        · 强调色不再是色相而是"更亮/更深的中性色"： Brush.Accent 做结构高亮，
          Brush.AccentSoft 做它的软底。全应用只有 Brush.Warning / Brush.Danger 保留色相，
          且已降饱和 —— 只用来区分 Git 的"已修改 / 已删除"；
        · 字号一律不动：多语言长文案已经顶到槽位边界，层级改由字重与灰度表达。
    -->

    <!-- 品牌叠卡矢量徽标（MainWindow 顶栏、暂存台与关于页共用） -->
    <DataTemplate x:Key="ShelfFileStackGlyph">
        <Viewbox Stretch="Uniform">
            <Canvas Width="64" Height="64">
                <Rectangle Canvas.Left="11" Canvas.Top="7" Width="34" Height="43" RadiusX="7" RadiusY="7" Fill="{DynamicResource Brush.ShelfCardBack}" Opacity="0.92" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="-13"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="19" Canvas.Top="8" Width="34" Height="43" RadiusX="7" RadiusY="7" Fill="{DynamicResource Brush.ShelfSecondary}" Opacity="0.38" RenderTransformOrigin="0.5,1">
                    <Rectangle.RenderTransform>
                        <RotateTransform Angle="8"/>
                    </Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Left="17" Canvas.Top="18" Width="35" Height="42" RadiusX="7" RadiusY="7" Fill="{DynamicResource Brush.ShelfCard}" Stroke="{DynamicResource Brush.ShelfBorder}" StrokeThickness="1"/>
            </Canvas>
        </Viewbox>
    </DataTemplate>

    <!-- ============================ 窗口 ============================ -->

    <!--
        窗口上没有隐式样式了 —— 以前这里有一个 <Style TargetType="Window">，
        挂着"文字默认色"和"排版方向"两个 setter。看着挺对，其实一次也没落到窗口上：
        **WPF 的隐式样式按元素的精确类型找**，MainWindow / SettingsWindow 这些派生类
        不继承基类的隐式样式。实测后果：暗色主题下没套具名样式的文字黑压黑（看不见），
        阿拉伯语也从来没镜像过。

        这两件事改由 LanguageService 用类处理器逐个窗口设（见那里的说明）——
        隐式样式这条路上根本到不了派生窗口。
    -->

    <Style x:Key="ActionBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,10" />
    </Style>

    <!--
        底部动作条（保存 / 取消 / 刷新 …）：LTR 靠右，RTL 靠左。

        WPF 的 HorizontalAlignment 是**物理**方向，不会跟着 FlowDirection 翻 ——
        所以不能直接写死 Right，得用触发器跟着方向换。
        StackPanel 的子元素顺序、Grid 的列顺序，FlowDirection 自己就会镜像，
        只有这种"钉在一边"的显式对齐需要手工翻。
    -->
    <Style x:Key="Actions.End" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 同一份规则给"按钮自己靠行首/靠行尾"用（新建分组按钮这类） -->
    <Style x:Key="Align.Start" TargetType="FrameworkElement">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Align.End" TargetType="FrameworkElement">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        上面这两个是给"身上没有别的样式"的元素用的。
        已经带样式的元素只能靠派生样式再加一层（一个元素只有一个 Style 属性），
        所以下面每个基础样式后面都跟一个 .Start / .End 变体。
    -->

    <!-- ============================ 焦点环 ============================ -->

    <!--
        自绘模板的控件没有主题给的默认焦点样式，键盘走到那一站屏上什么都不变。
        统一用这一枚：2px 强调色描边、往外让 3px（画在旁边，不抢内容的位置）。
    -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3"
                               RadiusX="8" RadiusY="8"
                               Stroke="{DynamicResource Brush.Accent}"
                               StrokeThickness="2"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 文本 ============================ -->

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!--
        标题右边跟着一段摘要时用的样式：摘要离标题留一道缝。
        Margin 是**物理**方向，不会跟着 FlowDirection 翻 ——
        摘要被翻到标题左边时，缝也得跟着挪到另一边，不然缝开在面板边上、标题和摘要贴在一起。
    -->
    <Style x:Key="Text.Caption.Gap" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="Margin" Value="0,0,8,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Text.Tertiary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- 路径 / 分支 / 大小：等宽，尾部要能对齐 -->
    <Style x:Key="Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Mono.Primary" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
    </Style>

    <!--
        路径与它前面那句说明词之间的缝（跟 Text.Caption.Gap 一个道理）：
        Margin 是**物理**方向，不会跟着 FlowDirection 翻。
    -->
    <Style x:Key="Text.Mono.Primary.Gap" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono.Primary}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="Margin" Value="0,0,8,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Text.Wrap" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="None" />
    </Style>

    <!-- ============================ 按钮 ============================ -->

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Thickness.ControlPadding}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Layout">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                Padding="{TemplateBinding Padding}">
                            <!-- 前景必须从按钮继承：不写这一句，隐式 TextBlock 样式会替它决定颜色 -->
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <!--
                            悬停反馈画在内容之上的一层半透明叠加层，而不是替换 Root.Background。
                            主键是浅底深字，一旦把背景换成 Brush.Hover，深字就压在深底上了。
                        -->
                        <Border x:Name="HoverLayer"
                                Background="{DynamicResource Brush.HoverOverlay}"
                                CornerRadius="{DynamicResource Radius.Control}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverLayer" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Layout" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主操作：写回。全应用只此一处用"反相"实体块 —— 亮中性底压深字（浅色主题反过来）。
         没有色相，靠的是底色与页面底之间最大的亮度差。 -->
    <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="16,6,16,6" />
    </Style>

    <!-- 主操作 + 靠行尾（LTR 右 / RTL 左） -->
    <Style x:Key="Button.Primary.End" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 次级操作：不要边框，只靠字重与底色 -->
    <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <!-- 次级操作 + 靠行首（LTR 左 / RTL 右） -->
    <Style x:Key="Button.Ghost.Start" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 纯图标按钮：统一 30×30 点击目标，悬停柔和变亮 -->
    <Style x:Key="Button.IconOnly" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 侧栏导航按钮：铺满行宽，左对齐图标+文字，悬停高亮正文色 -->
    <Style x:Key="Button.SidebarNav" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 自绘标题栏窗口控制按钮（最小化 / 最大化） -->
    <Style x:Key="Button.Caption" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 自绘标题栏关闭按钮：悬停使用品牌/系统危险红底白字 -->
    <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.82" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 「浏览…」：只画一个省略号，文案挪到 ToolTip 与无障碍名（英文 "Browse…" 比中文长得多，
         行尾放不下会被裁掉，而它后面就是滚动条） -->
    <Style x:Key="Button.Picker" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Content" Value="…" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    </Style>

    <!-- ============================ 输入 ============================ -->

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,4,7,4" />
        <Setter Property="MinHeight" Value="28" />
        <!-- 这一类自己会把边框变成强调色，不再叠一圈焦点环 -->
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ComboBox 必须自己写模板：默认的那个在深色主题下是一块白板
        （用的是系统颜色，跟主题 token 无关）。
    -->

    <!--
        下拉箭头：LTR 在右边，RTL 在左边，内边距也跟着换边。
        箭头本身朝下 —— 那是"展开"的意思，不是方向，别跟着镜像。
    -->
    <Style x:Key="ComboBox.Chevron" TargetType="Path">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ComboBox.Toggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <!-- 必须有 ContentPresenter：没有它，内容整个不会被渲染 -->
                    <Border Background="Transparent">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,3,22,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle"
                                      Focusable="False"
                                      Style="{StaticResource ComboBox.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{DynamicResource Radius.Control}">
                                    <ContentPresenter x:Name="Content"
                                                      Margin="{TemplateBinding Padding}"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource Align.Start}" />
                                </Border>

                                <Path Data="M0,0 L3.5,3.5 L7,0"
                                      Stroke="{DynamicResource Brush.TextSecondary}"
                                      StrokeThickness="1.2"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource ComboBox.Chevron}" />
                            </Grid>
                        </ToggleButton>

                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.BorderStrong}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}"
                                    Margin="0,2,0,0"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer MaxHeight="260">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter Property="Padding" Value="22,3,9,3" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉框 + 靠行首（LTR 左 / RTL 右）：标签右边那个框要贴着标签 -->
    <Style x:Key="ComboBox.Start" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Style.Triggers>
            <Trigger Property="FlowDirection" Value="RightToLeft">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Menu}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            <!--
                                选中态不画强调色文字：中性石墨语言里层级靠表面亮度差 + 字重，
                                底色 + 字重已经够说明"是这一项"，不需要再叠一层颜色。
                            -->
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        开关（原 CheckBox）：magpie 那种药丸拨杆，放在标签行首。

        外层用 Grid 两列（Auto 轨道 + * 标签）：**Grid 的列顺序会跟着 FlowDirection
        自己镜像**，所以阿拉伯语下轨道自动落到另一边，不用写死 Left/Right。
        只有 Margin 是物理方向，得用触发器换边（和 Align.Start / End 一个道理）。
        不用 DockPanel —— Dock 不会自动镜像。

        轨道内部固定 LTR：滑块只由 IsChecked 决定左右，拨杆方向是控件语义、
        不是阅读方向，绝不能被窗口的 RTL 带出轨道。
        只画"轨道 + 滑块"两枚圆角矩形，颜色全走 DynamicResource，不残留系统色。
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Layout" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 轨道：列顺序随 FlowDirection 镜像，Margin 用触发器换边 -->
                        <Border x:Name="Track"
                                Grid.Column="0"
                                Width="30" Height="16"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceSunken}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <!-- 轨道内部固定 LTR，滑块不会被窗口的 RTL 带出轨道 -->
                            <Grid FlowDirection="LeftToRight">
                                <Border x:Name="Knob"
                                        Width="10" Height="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        Background="{DynamicResource Brush.TextSecondary}"
                                        CornerRadius="{DynamicResource Radius.Control}" />
                            </Grid>
                        </Border>

                        <!-- 标签继承窗口的 FlowDirection（RTL 由 LanguageService 设在窗口上） -->
                        <ContentPresenter x:Name="Content"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 关 → 开：滑块换到另一端，轨道与滑块反相高亮 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.AccentText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <!-- Margin 是物理方向：轨道翻到另一边时缝也得跟着挪 -->
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="Track" Property="Margin" Value="9,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <!-- 勾选正文要能折行：德语实测最长的一条比它的槽位宽 146 DIP，直接冲出窗口右缘被裁。
             写法必须是给字符串内容一个模板 —— 不能写
             Setter Property="TextBlock.TextWrapping"：TextWrapping 不是附加属性，
             挂在 CheckBox 上没有读者，看着像设了其实空转（这里原来就是那样）。 -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 右对齐开关：设置页使用，标签在左、拨杆沿右边缘对齐（与下拉框、快捷键框一致） -->
    <Style x:Key="CheckBox.ToggleRight" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid x:Name="Layout" Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentPresenter x:Name="Content"
                                          Grid.Column="0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Border x:Name="Track"
                                Grid.Column="1"
                                Width="34" Height="18"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource Brush.SurfaceSunken}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Pill}">
                            <Grid FlowDirection="LeftToRight">
                                <Border x:Name="Knob"
                                        Width="12" Height="12"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Margin="2,0,0,0"
                                        Background="{DynamicResource Brush.TextSecondary}"
                                        CornerRadius="{DynamicResource Radius.Pill}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.AccentText}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="FlowDirection" Value="RightToLeft">
                            <Setter TargetName="Track" Property="Margin" Value="0,0,14,0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <!-- 这里原来也有一条 Setter Property="TextBlock.TextWrapping"：空转（见上面 CheckBox 的说明），
             删掉。RadioButton 的文案都是短词（原位置 / 浅色 / 跟随系统），真要折行再按 CheckBox 那样给模板。 -->
    </Style>

    <!-- ============================ 列表 ============================ -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- 列表项：默认模板带系统边框（深色主题下是一圈亮边），换成平的 -->
    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 树（台面） ============================ -->

    <!--
        展开箭头。**必须定义在 TreeViewItem 样式之前** ——
        StaticResource 是按文档顺序解析的，定义在后面会报
        "无法找到名为 ToggleButton.Expander 的资源"，而且它是在第一次布局时才炸，
        报错现场离出错点十万八千里。
    -->
    <Style x:Key="ToggleButton.Expander" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 树里的一行：平的一行 + 选中时的左侧强调条 -->
    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,0" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Row"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--
                                    展开箭头：键盘必须能到达（原来是 Focusable=False，
                                    结果键盘用户根本展不开文件夹），命中区 22 DIP。
                                -->
                                <ToggleButton x:Name="Expander"
                                              Grid.Column="0"
                                              Width="22"
                                              Height="22"
                                              Focusable="True"
                                              VerticalAlignment="Center"
                                              FocusVisualStyle="{StaticResource FocusRing}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource ToggleButton.Expander}">
                                    <Path Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Brush.TextTertiary}"
                                          StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </ToggleButton>

                                <ContentPresenter x:Name="PART_Header"
                                                  Grid.Column="1"
                                                  ContentSource="Header"
                                                  HorizontalAlignment="Stretch" />
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="ItemsHost" Margin="22,0,0,0" />
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </MultiTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.Selection}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 分段控件 ============================ -->

    <!--
        目标模式（原位置 / 其他根目录 / 指定路径）用分段控件而不是三个散着的单选框：
        它们本来就是一组互斥的档位，应该读成一个整体。
        每一段**不画自己的边框** —— 边框由外层那个凹槽承担，
        否则三个档位会读成三个独立按钮，而不是一组档位。
        分段使用小圆角矩形，靠表面亮度差区分选中状态。
    -->
    <Style x:Key="Segment.Option" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="11,5,11,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <!-- 选中档位读成凹槽里的一颗凸起药丸：表面提亮 + 字重 + 主色文字 -->
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
                            <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 滚动条 ============================ -->

    <!--
        必须自绘：默认模板的轨道与上下按钮用的是系统颜色，深色主题下是一条亮灰轨贴在暗底上
        （浅色下也一样，只是看不出来）。顺带把只有 4.67×17 的上下按钮去掉 ——
        整条轨道都能点（翻页），滑块 10 DIP 宽、最短 24 DIP。
    -->
    <Style x:Key="ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbRoot"
                            Background="{DynamicResource Brush.BorderStrong}"
                            CornerRadius="3"
                            Margin="2,1,2,1" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot" Property="Background" Value="{DynamicResource Brush.TextTertiary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <!-- 竖条是默认朝向：只钉宽 12，高必须留给容器拉伸。
             这里同时钉高会把竖条压成一颗 12×12 的药丸，浮在轨道中间。 -->
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PageBackward"
                                              Style="{StaticResource ScrollBar.Page}"
                                              Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb"
                                       Style="{StaticResource ScrollBar.Thumb}"
                                       MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PageForward"
                                              Style="{StaticResource ScrollBar.Page}"
                                              Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="12" />
                            <Setter TargetName="Thumb" Property="MinHeight" Value="0" />
                            <Setter TargetName="Thumb" Property="MinWidth" Value="24" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                            <Setter TargetName="PageBackward" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
                            <Setter TargetName="PageForward" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
                        </Trigger>
                        <!-- 内容不溢出时滚动条是禁用的：让整条透明，但 12 DIP 的槽还留着，
                             表头与数据列才不会因为它出现/消失而错位。 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Brush.BorderStrong}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Margin="2,0,2,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 数据表 ============================ -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="None" />
        <Setter Property="RowHeight" Value="32" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="False" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    默认模板在选中时把底色换成系统高亮色 —— 深色主题下是"亮带 + 浅色字"，
                    实测 1.04:1，整行内容看不见。自己画一层，选中态走主题 token。
                -->
                <ControlTemplate TargetType="DataGridCell">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selection}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ 浮层：菜单 ============================ -->

    <!--
        右键菜单与托盘菜单都走 WPF 默认模板，而默认模板用的是 SystemColors.MenuBrush ——
        深色主题下是"浅色板 + 主题的浅色字"，实测 1.1:1，整块菜单看不见。
        这与 ComboBox 当年那块白板是同一类：**没自绘的控件不吃主题 token**。
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="MinWidth" Value="196" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Panel}"
                            Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Menu}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="MinHeight" Value="34" />
        <!-- 这些菜单里没有图标，默认模板那条 28 DIP 的图标槽整个是空的，所以不再留 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter ContentSource="Header"
                                          VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ 杂项 ============================ -->

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="0,6,0,6" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Brush.SurfaceElevated}"
                            BorderBrush="{DynamicResource Brush.BorderStrong}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Radius.Control}"
                            Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    </Style>

</ResourceDictionary>
