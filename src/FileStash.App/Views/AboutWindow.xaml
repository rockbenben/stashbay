<Window x:Class="FileStash.App.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.AboutTitle}"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="420"
        Height="300"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Static app:Strings.AppName}"
                   FontSize="22"
                   FontWeight="SemiBold" />

        <TextBlock Grid.Row="1"
                   Margin="0,6,0,0"
                   Style="{StaticResource Text.Caption}"
                   TextWrapping="Wrap"
                   Text="{x:Static app:Strings.AboutTagline}" />

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="12"
                Background="{DynamicResource Brush.SurfaceAlt}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Radius.Panel}">
            <StackPanel>
                <TextBlock x:Name="VersionText" />
                <TextBlock x:Name="RuntimeText" Margin="0,6,0,0" Style="{StaticResource Text.Caption}" />
                <TextBlock x:Name="GitText" Margin="0,6,0,0" Style="{StaticResource Text.Caption}" />
                <!--
                    数据目录那行是路径：没有 TextTrimming 时它按整行宽度要空间，
                    撑破边框 —— 阿拉伯语下从左边冲出去，窗边裁掉的是路径开头
                    （"C:\Users\..." 变成 "ocal\Temp\..."）。
                    截断 + ToolTip：省略号收尾，完整路径看悬停。
                -->
                <TextBlock x:Name="DataText"
                           Margin="0,6,0,0"
                           Style="{StaticResource Text.Caption}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, ElementName=DataText}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3"
                Content="{x:Static app:Strings.OkButton}"
                Width="90"
                Margin="0,16,0,0"
                IsCancel="True"
                Click="OnClose"
                Style="{StaticResource Button.Primary.End}" />
    </Grid>
</Window>
