<Window x:Class="FileStash.App.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.HistoryTitle}"
        Icon="pack://application:,,,/StashBay;component/Resources/app.ico"
        Width="940"
        Height="580"
        MinWidth="640"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Cell.Trimmed" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="18,14,18,10">
            <TextBlock Text="{x:Static app:Strings.HistoryTitle}" Style="{StaticResource Text.Title}" FontSize="17" />
        </Border>

        <Grid Grid.Row="1" Margin="18,0,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="520*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- 操作列表卡片 -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Padding="4">
                <DataGrid ItemsSource="{Binding Operations}"
                          SelectedItem="{Binding SelectedOperation}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static app:Strings.ColumnTime}" Binding="{Binding TimeText}" Width="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                                    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="{x:Static app:Strings.ColumnTarget}"
                                            Binding="{Binding TargetText}"
                                            Width="*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                                    <Setter Property="ToolTip" Value="{Binding TargetText}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static app:Strings.ColumnStatus}" Width="112">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBackground}" CornerRadius="{DynamicResource Radius.Pill}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusForeground}" FontSize="{DynamicResource Font.Size.Caption}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                          FocusVisualStyle="{StaticResource FocusRing}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- 明细列表卡片 -->
            <Border Grid.Column="2"
                    Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Radius.Panel}"
                    Padding="4">
                <DataGrid ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource Brush.Border}"
                          Background="Transparent"
                          BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{x:Static app:Strings.ColumnTargetPath}"
                                            Binding="{Binding TargetPath}"
                                            Width="*"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                                    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                                    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
                                    <Setter Property="ToolTip" Value="{Binding TargetPath}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="{x:Static app:Strings.ColumnResult}" Width="96">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding ActionBackground}" CornerRadius="{DynamicResource Radius.Pill}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActionText}" Foreground="{Binding ActionForeground}" FontSize="{DynamicResource Font.Size.Caption}" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{x:Static app:Strings.ColumnError}"
                                            Binding="{Binding Error}"
                                            Width="180"
                                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Setter Property="ToolTip" Value="{Binding Error}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ActionBar}">
            <StackPanel Style="{StaticResource Actions.End}">
                <Button Content="{x:Static app:Strings.RefreshButton}" Command="{Binding LoadCommand}" />
                <Button Content="{x:Static app:Strings.UndoThisButton}"
                        Margin="6,0,0,0"
                        ToolTip="{x:Static app:Strings.UndoNeedsWrite}"
                        Command="{Binding UndoCommand}"
                        IsEnabled="{Binding CanUndoSelected}" />
                <Button Content="{x:Static app:Strings.KeepCurrentButton}"
                        Margin="6,0,0,0" Command="{Binding KeepCurrentCommand}" IsEnabled="{Binding CanKeepCurrent}" />
                <Button Content="{x:Static app:Strings.OpenTargetFolderButton}"
                        Margin="6,0,0,0"
                        Command="{Binding OpenTargetFolderCommand}"
                        IsEnabled="{Binding HasSelection}" />
                <Button Content="{x:Static app:Strings.CloseButton}"
                        Margin="6,0,0,0"
                        IsCancel="True"
                        Click="OnClose" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
