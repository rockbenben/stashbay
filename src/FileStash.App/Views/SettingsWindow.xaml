<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        xmlns:ctrl="clr-namespace:FileStash.App.Controls"
        x:Class="FileStash.App.Views.SettingsWindow"
        Title="{x:Static app:Strings.SettingsTitle}"
        Icon="pack://application:,,,/StashBay;component/Resources/app.ico"
        Width="820" Height="680" MinWidth="640" MinHeight="360"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Settings.Hint" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Settings.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Settings.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" ContentSource="Header" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                <Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TabControl x:Name="SettingsTabs" Grid.Row="0" TabStripPlacement="Left" SelectedIndex="0" BorderThickness="0" Background="Transparent" KeyboardNavigation.TabNavigation="Continue">
            <TabControl.Style>
                <Style TargetType="TabControl">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsStartupBusy}" Value="True">
                            <Setter Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Style>
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="184"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="12,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" KeyboardNavigation.DirectionalNavigation="Contained"/>
                            </ScrollViewer>
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Column="1" ContentSource="SelectedContent"/>
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="{x:Static app:Strings.SectionGeneral}" x:Name="GeneralSettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ctrl:WheelScroll.IsEnabled="True" Padding="24,20,24,20" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SectionGeneral}"/>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.LanguageLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <ComboBox Grid.Column="1" Width="185" ItemsSource="{Binding Languages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Language, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.LanguageLabel}"/>
                                </Grid>
                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.ThemeLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <ComboBox Grid.Column="1" Width="185" ItemsSource="{Binding Themes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.Theme, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.ThemeLabel}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,6,0,8"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,8" Content="{x:Static app:Strings.CloseToTrayLabel}" IsChecked="{Binding Settings.CloseToTray, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,4" Content="{x:Static app:Strings.StartMinimizedLabel}" IsChecked="{Binding Settings.MinimizeToTray, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SettingsShortcuts}" FontSize="14" Margin="0,2,0,6"/>
                                <TextBlock Style="{StaticResource Settings.Hint}" Text="{x:Static app:Strings.HotkeyRecordingHint}"/>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.HotkeyLabel}" TextWrapping="Wrap" Margin="0,0,12,0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctrl:HotkeyBox Style="{StaticResource {x:Type TextBox}}" x:Name="HotkeyAddBox" MinHeight="32" Text="{Binding Settings.GlobalHotkeyAdd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.HotkeyLabel}" Grid.Column="1" Width="160" ToolTip="{x:Static app:Strings.HotkeyRecordingHint}" AutomationProperties.HelpText="{x:Static app:Strings.HotkeyRecordingHint}"/>
                                    <Button Grid.Column="2" Content="{x:Static app:Strings.HotkeyClearButton}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnClearHotkeyAddClick"/>
                                </Grid>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.HotkeyWorkbenchLabel}" TextWrapping="Wrap" Margin="0,0,12,0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctrl:HotkeyBox Style="{StaticResource {x:Type TextBox}}" x:Name="HotkeyWorkbenchBox" MinHeight="32" Text="{Binding Settings.GlobalHotkeyWorkbench, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.HotkeyWorkbenchLabel}" Grid.Column="1" Width="160" ToolTip="{x:Static app:Strings.HotkeyRecordingHint}" AutomationProperties.HelpText="{x:Static app:Strings.HotkeyRecordingHint}"/>
                                    <Button Grid.Column="2" Content="{x:Static app:Strings.HotkeyClearButton}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnClearHotkeyWorkbenchClick"/>
                                </Grid>
                                <Grid Margin="0,6,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.HotkeyPasteLabel}" TextWrapping="Wrap" Margin="0,0,12,0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <ctrl:HotkeyBox Style="{StaticResource {x:Type TextBox}}" x:Name="HotkeyPasteBox" MinHeight="32" Text="{Binding Settings.GlobalHotkeyPaste, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static app:Strings.HotkeyPasteLabel}" Grid.Column="1" Width="160" ToolTip="{x:Static app:Strings.HotkeyRecordingHint}" AutomationProperties.HelpText="{x:Static app:Strings.HotkeyRecordingHint}"/>
                                    <Button Grid.Column="2" Content="{x:Static app:Strings.HotkeyClearButton}" Style="{StaticResource Button.Ghost}" Margin="8,0,0,0" Click="OnClearHotkeyPasteClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static app:Strings.SettingsShelf}" x:Name="ShelfSettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ctrl:WheelScroll.IsEnabled="True" Padding="24,20,24,20" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SettingsShelf}"/>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <StackPanel Margin="0,4,0,10">
                                    <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.RemoveAfterDragExportLabel}" IsChecked="{Binding Settings.RemoveAfterDragExport, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,0" Text="{x:Static app:Strings.RemoveAfterDragExportTooltip}"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,2,0,10"/>
                                <StackPanel Margin="0,2,0,4">
                                    <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.AutoDismissWhenEmptyLabel}" IsChecked="{Binding Settings.AutoDismissWhenEmpty, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,0" Text="{x:Static app:Strings.AutoDismissWhenEmptyTooltip}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <StackPanel Margin="0,4,0,10">
                                    <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.SummonAtCursorLabel}" IsChecked="{Binding Settings.SummonAtCursor, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,0" Text="{x:Static app:Strings.SummonAtCursorTooltip}"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,2,0,10"/>
                                <StackPanel Margin="0,2,0,4">
                                    <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.EnableShakeToSummonLabel}" IsChecked="{Binding Settings.EnableShakeToSummon, Mode=TwoWay}"/>
                                    <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,0" Text="{x:Static app:Strings.EnableShakeToSummonTooltip}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Settings.Hint}" Text="{x:Static app:Strings.ShelfCleanupHint}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static app:Strings.SettingsFiles}" x:Name="FilesSettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ctrl:WheelScroll.IsEnabled="True" Padding="24,20,24,20" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SettingsFiles}"/>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <Grid Margin="0,6,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.DefaultConflictPolicyLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <ComboBox Grid.Column="1" Width="185" ItemsSource="{Binding Policies}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Settings.DefaultConflictPolicy, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.DefaultConflictPolicyLabel}"/>
                                </Grid>
                                <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,2,0,8"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,8" Content="{x:Static app:Strings.SkipIdenticalLabel}" IsChecked="{Binding Settings.SkipIdentical, Mode=TwoWay}"/>
                                <CheckBox x:Name="BackupBeforeOverwriteCheck" Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,4" Content="{x:Static app:Strings.BackupBeforeOverwriteLabel}" IsChecked="{Binding Settings.BackupBeforeOverwrite, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Settings.SectionTitle}" FontSize="14" Margin="0,2,0,6" Text="{x:Static app:Strings.SectionExcludes}"/>
                                <TextBlock Style="{StaticResource Settings.Hint}" Text="{x:Static app:Strings.ExcludeHint}"/>
                                <TextBox MinHeight="110" Margin="0,4,0,4" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static app:Strings.SectionExcludes}" Text="{Binding ExcludeGlobsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="GitSettingsSection" Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SectionDeveloperOptions}" FontSize="14" Margin="0,2,0,6"/>
                                <TextBlock Style="{StaticResource Settings.Hint}" Text="{x:Static app:Strings.DeveloperOptionsHint}"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,8" Content="{x:Static app:Strings.AutoGitAddLabel}" IsChecked="{Binding Settings.AutoGitAddAfterApply, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,8" Content="{x:Static app:Strings.WatchBranchLabel}" IsChecked="{Binding Settings.WatchGitBranchSwitch, Mode=TwoWay}"/>
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,4" Content="{x:Static app:Strings.RespectGitIgnoreLabel}" IsChecked="{Binding Settings.RespectGitIgnore, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static app:Strings.SectionWindowsIntegration}" x:Name="WindowsSettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ctrl:WheelScroll.IsEnabled="True" Padding="24,20,24,20" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SectionWindowsIntegration}"/>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <CheckBox x:Name="LogonStartupCheck" Style="{StaticResource CheckBox.ToggleRight}" Margin="0,6,0,8" Content="{x:Static app:Strings.StartWithWindowsLabel}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                                <StackPanel Margin="0,4,0,0" IsEnabled="{Binding IsChecked, ElementName=LogonStartupCheck}">
                                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Margin="0,4,0,10"/>
                                    <StackPanel Margin="0,2,0,4">
                                        <CheckBox x:Name="AdministratorStartupCheck" Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.StartupAdminLabel}" IsChecked="{Binding StartWithWindowsAsAdministrator, Mode=TwoWay}"/>
                                        <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,6" Text="{x:Static app:Strings.StartupAdminHint}"/>
                                    </StackPanel>
                                    <Grid Margin="0,2,0,8" Visibility="{Binding IsChecked, ElementName=AdministratorStartupCheck, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Static app:Strings.StartupDelayLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Style="{StaticResource Text.Body}"/>
                                        <TextBox Grid.Column="1" Width="64" Height="28" TextAlignment="Center" VerticalContentAlignment="Center"
                                                 Text="{Binding StartupDelayText, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="{x:Static app:Strings.StartupDelayLabel}"
                                                 ToolTip="{x:Static app:Strings.StartupDelayRange}"/>
                                    </Grid>
                                </StackPanel>
                                <Border x:Name="StartupStatusCard" Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="14,10" Margin="0,8,0,4">
                                    <StackPanel>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="StatusDot" Width="8" Height="8" CornerRadius="{DynamicResource Radius.Pill}" Margin="0,1,10,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Success}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding StartupUncertain}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource Brush.Warning}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" Text="{Binding StartupStatusText}" AutomationProperties.Name="{Binding StartupStatusText}" VerticalAlignment="Center" FontWeight="Medium" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                        </Grid>
                                        <WrapPanel Margin="18,10,0,0">
                                            <Button Content="{x:Static app:Strings.StartupRefresh}" Command="{Binding RefreshStartupCommand}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <Button x:Name="RepairStartupButton" Content="{x:Static app:Strings.StartupRepair}" Command="{Binding RepairStartupCommand}" IsEnabled="{Binding IsChecked, ElementName=LogonStartupCheck}" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel Margin="0,4,0,4">
                                <CheckBox Style="{StaticResource CheckBox.ToggleRight}" Content="{x:Static app:Strings.ContextMenuLabel}" IsChecked="{Binding Settings.ContextMenuEnabled, Mode=TwoWay}"/>
                                <TextBlock Style="{StaticResource Settings.Hint}" Margin="0,4,48,0" Text="{x:Static app:Strings.ContextMenuHint}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{x:Static app:Strings.SectionStorage}" x:Name="StorageSettingsTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ctrl:WheelScroll.IsEnabled="True" Padding="24,20,24,20" Foreground="{DynamicResource Brush.TextPrimary}" FontWeight="Normal">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Settings.SectionTitle}" Text="{x:Static app:Strings.SectionStorage}"/>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <TextBlock Text="{Binding StorageText}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ExportText}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding HistoryText}" TextWrapping="Wrap" Style="{StaticResource Text.Caption}"/>
                                <WrapPanel Margin="0,14,0,0">
                                    <Button Margin="0,0,8,4" Content="{x:Static app:Strings.RefreshStorageButton}" Command="{Binding RefreshStorageCommand}"/>
                                    <Button Margin="0,0,8,4" Content="{x:Static app:Strings.CleanupStorageButton}" Command="{Binding CleanupUnreferencedCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Settings.Card}">
                            <StackPanel>
                                <Grid Margin="0,6,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Static app:Strings.HistoryRetentionLabel}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"/>
                                    <TextBox Grid.Column="1" Width="72" Text="{Binding Settings.HistoryRetentionDays, Mode=TwoWay}" AutomationProperties.Name="{x:Static app:Strings.HistoryRetentionLabel}"/>
                                </Grid>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Margin="0,0,8,4" Content="{x:Static app:Strings.ClearHistoryButton}" Command="{Binding ClearHistoryCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="1" Style="{StaticResource ActionBar}">
            <StackPanel Style="{StaticResource Actions.End}">
                <Button x:Name="SaveSettingsButton" Content="{x:Static app:Strings.SaveButton}" Click="OnSave" MinWidth="92"
                        Style="{StaticResource Button.Primary}" IsEnabled="{Binding CanSaveSettings}"/>
                <Button Content="{x:Static app:Strings.CancelButton}" Margin="8,0,0,0" MinWidth="88" IsCancel="True" Click="OnCancel">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStartupBusy}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
