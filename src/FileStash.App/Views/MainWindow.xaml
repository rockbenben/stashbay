<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FileStash.App.ViewModels"
        xmlns:ctrl="clr-namespace:FileStash.App.Controls"
        xmlns:conv="clr-namespace:FileStash.App.Converters"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        x:Class="FileStash.App.Views.MainWindow"
        Title="{x:Static app:Strings.AppName}"
        Icon="pack://application:,,,/StashBay;component/Resources/app.ico"
        Width="1180" Height="760" MinWidth="900" MinHeight="380"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragEnter="OnWindowDragEnter"
        DragOver="OnWindowDragOver"
        DragLeave="OnWindowDragLeave"
        Drop="OnWindowDrop"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <conv:EnumMatchConverter x:Key="EnumMatch"/>
        <conv:WorkbenchChildrenConverter x:Key="WorkbenchChildren"/>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>

        <Style x:Key="ShelfRestoreButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile" CornerRadius="10" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.ShelfHover}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Brush.ShelfBorder}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Tile" Property="Opacity" Value="0.65"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ItemsPanelTemplate x:Key="ShelfTiles">
            <WrapPanel ItemWidth="84" ItemHeight="74"/>
        </ItemsPanelTemplate>

        <DataTemplate x:Key="ShelfTile" DataType="{x:Type vm:ItemViewModel}">
            <Border Width="80" Height="70" Margin="2" Padding="6" CornerRadius="8" ToolTip="{Binding SourcePath}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Source="{Binding FileIcon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1" Text="{Binding DisplayName}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="ShelfItems" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="ctrl:WheelScroll.IsEnabled" Value="True"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
            <Setter Property="ItemsPanel" Value="{StaticResource ShelfTiles}"/>
            <Setter Property="ItemTemplate" Value="{StaticResource ShelfTile}"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="FocusBorder" BorderThickness="1" CornerRadius="8" BorderBrush="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter TargetName="FocusBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="ShelfMenu" x:Shared="False">
            <MenuItem Header="{x:Static app:Strings.TrayApplyOriginal}" Command="{Binding ApplyOriginalCommand}" CommandParameter="{Binding SelectedItem}"/>
            <MenuItem Header="{x:Static app:Strings.MenuOpenSource}" Command="{Binding OpenSourceLocationCommand}" CommandParameter="{Binding SelectedItem}"/>
            <MenuItem Header="{x:Static app:Strings.MenuCopySourcePath}" Command="{Binding CopySourcePathCommand}" CommandParameter="{Binding SelectedItem}"/>
            <Separator/>
            <MenuItem Header="{x:Static app:Strings.DeleteItemTitle}" Command="{Binding RemoveItemDirectCommand}" CommandParameter="{Binding SelectedItem}"/>
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewShelfCommand}"/>
        <KeyBinding Key="V" Modifiers="Control" Command="{Binding PasteCommand}"/>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewGroupCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding AddItemsCommand}"/>
        <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding AddItemsCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveCommand}"/>
        <KeyBinding Key="F2" Command="{Binding RenameGroupCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F11" Command="{Binding ToggleCompactCommand}"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleCompactCommand}"/>
    </Window.InputBindings>

    <Grid>
        <!-- ================= 紧凑暂存台（Transit Shelf） ================= -->
        <Border x:Name="CompactShell"
                CornerRadius="12"
                SizeChanged="OnCompactShellSizeChanged"
                Background="{DynamicResource Brush.ShelfSurface}"
                BorderBrush="{DynamicResource Brush.ShelfBorder}"
                BorderThickness="1"
                Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}"
                PreviewMouseLeftButtonDown="OnCompactDoubleClick">
            <Grid Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部栏：左侧青绿指示点 + 箱名，右侧显式展开工作台 + 关闭 -->
                <Grid Grid.Row="0" Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"
                          Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{DynamicResource Brush.Accent}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ShelfHeader}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.ShelfSecondary}" FontSize="11.5" FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding ShelfHeader}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource Button.Ghost}"
                                Width="26" Height="26" MinHeight="26" Padding="0" Margin="0,0,2,0"
                                Command="{Binding ExpandCommand}"
                                ToolTip="{x:Static app:Strings.TrayOpenWorkbench}"
                                AutomationProperties.Name="{x:Static app:Strings.TrayOpenWorkbench}">
                            <Path Data="M15 3H21V9M9 21H3V15M21 3L14 10M3 21L10 14"
                                  Stroke="{DynamicResource Brush.ShelfSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource Button.Ghost}"
                                Width="26" Height="26" MinHeight="26" Padding="0"
                                ToolTip="{x:Static app:Strings.CloseButton}"
                                AutomationProperties.Name="{x:Static app:Strings.CloseButton}"
                                Click="OnCloseClick">
                            <Path Data="M5 5L15 15M15 5L5 15"
                                  Stroke="{DynamicResource Brush.ShelfSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 唯一整块拖出区：叠卡 + 拖出提示 + 首项文件名与总大小摘要 -->
                <Border x:Name="ShelfExportSurface" Grid.Row="1"
                        Background="Transparent" Cursor="Hand"
                        Margin="18,0,18,4" Focusable="True"
                        KeyDown="OnShelfExportKeyDown"
                        MouseEnter="OnShelfStackHover" MouseLeave="OnShelfStackHover"
                        ToolTip="{x:Static app:Strings.DragAllTooltip}"
                        AutomationProperties.Name="{x:Static app:Strings.DragAllTooltip}"
                        PreviewMouseLeftButtonDown="OnDragAllPreviewMouseLeftButtonDown"
                        PreviewMouseMove="OnDragAllPreviewMouseMove">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasNoItems}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="0,2">
                        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False" MaxWidth="226">
                            <Grid x:Name="ShelfStack" Width="56" Height="56" RenderTransformOrigin="0.5,0.7" Margin="0,0,0,8">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <ContentControl ContentTemplate="{StaticResource ShelfFileStackGlyph}"/>
                            </Grid>
                            <TextBlock Text="{x:Static app:Strings.ShelfDragPrompt}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Brush.ShelfText}"/>
                            <TextBlock Text="{Binding ShelfPreviewText}" FontSize="11.5" Margin="0,4,0,0" TextAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush.ShelfSecondary}"/>
                        </StackPanel>
                    </Viewbox>
                </Border>

                <!-- 空暂存台提示 -->
                <Grid Grid.Row="1" Margin="26,2,26,22" IsHitTestVisible="False" Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel VerticalAlignment="Center" Margin="14">
                        <ContentControl ContentTemplate="{StaticResource ShelfFileStackGlyph}" Width="56" Height="56" Margin="0,0,0,14"/>
                        <TextBlock Text="{x:Static app:Strings.ShelfDropPrompt}" FontSize="19" FontWeight="Medium" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Brush.ShelfSecondary}"/>
                    </StackPanel>
                </Grid>

                <!-- 底部三个写回动作按钮 -->
                <Grid x:Name="CompactStatusBar" Grid.Row="2" HorizontalAlignment="Center" Margin="0,2,0,10" Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="CompactRestoreOriginal" Grid.Column="0" Style="{StaticResource ShelfRestoreButton}" Command="{Binding ApplyOriginalCommand}" ToolTip="{x:Static app:Strings.TrayApplyOriginal}" AutomationProperties.Name="{x:Static app:Strings.TrayApplyOriginal}">
                        <Path Data="M9 5L4 10L9 15M4 10H14C18 10 20 13 20 17" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Brush.ShelfText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="CompactRestoreFolder" Grid.Column="1" Style="{StaticResource ShelfRestoreButton}" Command="{Binding RestoreToFolderCommand}" ToolTip="{x:Static app:Strings.TargetSpecifiedPath}" AutomationProperties.Name="{x:Static app:Strings.TargetSpecifiedPath}">
                        <Path Data="M3 6H9L11 8H21V20H3ZM12 11V17M9 14L12 17L15 14" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Brush.ShelfText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                    <Button x:Name="CompactRestoreRoot" Grid.Column="2" Style="{StaticResource ShelfRestoreButton}" Command="{Binding RestoreToRootCommand}" ToolTip="{x:Static app:Strings.TargetAnotherRoot}" AutomationProperties.Name="{x:Static app:Strings.TargetAnotherRoot}">
                        <Path Data="M5 3V8M19 3V8M5 5H19M12 5V11M8 15L12 11L16 15M12 11V21" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Brush.ShelfText}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Button>
                </Grid>

                <Border Grid.Row="2" Padding="14,8" Background="{DynamicResource Brush.ShelfSurface}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.ShelfSecondary}" TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 完整：工作台 ================= -->
        <Grid x:Name="WorkbenchRoot" Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= 顶栏 ================= -->
            <Border Grid.Row="0" Height="44" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="14,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 品牌图标 + 标题（非活动窗口时降低强调） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.65"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <ContentControl ContentTemplate="{StaticResource ShelfFileStackGlyph}" Width="22" Height="22" Margin="2,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBlock Text="{x:Static app:Strings.AppName}" Style="{StaticResource Text.Title}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 右侧工具 + 窗口控制按钮 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Content="{x:Static app:Strings.AbortButton}" Style="{StaticResource Button.Ghost}" Command="{Binding CancelCurrentOperationCommand}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Margin="0,0,6,0"/>

                        <!-- 搜索过滤框 -->
                        <Border WindowChrome.IsHitTestVisibleInChrome="True" Width="205" Height="30" Margin="0,0,8,0"
                                Background="{DynamicResource Brush.SurfaceSunken}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Control}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchInputBox}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="M11 3a8 8 0 1 0 5.3 14l4.3 4.3 1.4-1.4-4.3-4.3A8 8 0 0 0 11 3zm0 2a6 6 0 1 1 0 12 6 6 0 0 1 0-12z"
                                      Fill="{DynamicResource Brush.TextTertiary}" Width="12" Height="12" Margin="9,0,6,0" Stretch="Uniform" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static app:Strings.SearchPlaceholder}"
                                               Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                                               Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                                    <TextBox x:Name="SearchInputBox"
                                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Padding="0,2" MinHeight="24"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="{x:Static app:Strings.SearchPlaceholder}"/>
                                </Grid>
                                <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Width="24" Height="24" MinHeight="24" Padding="0" Margin="2,0,3,0"
                                        Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding HasSearchQuery, Converter={StaticResource BoolToVisibility}}"
                                        ToolTip="{x:Static app:Strings.ClearSearchTooltip}"
                                        AutomationProperties.Name="{x:Static app:Strings.ClearSearchTooltip}">
                                    <Path Data="M5 5L13 13M13 5L5 13" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" Width="8" Height="8" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 添加文件 -->
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding AddItemsCommand}" Padding="10,4" MinHeight="30" Height="30">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="{DynamicResource Brush.TextPrimary}" Width="11" Height="11" Margin="0,0,5,0" Stretch="Uniform"/>
                                <TextBlock Text="{x:Static app:Strings.AddButton}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 缩回紧凑暂存台 -->
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Ghost}" Command="{Binding CollapseCommand}" ToolTip="{x:Static app:Strings.CollapseButtonTooltip}" Margin="4,0,0,0" Padding="8,4" MinHeight="30" Height="30" AutomationProperties.Name="{x:Static app:Strings.CollapseButtonTooltip}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-14v3h3v2h-5V5h2z" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Margin="0,0,5,0" Stretch="Uniform"/>
                                <TextBlock Text="{x:Static app:Strings.CollapseButton}" VerticalAlignment="Center"/>
                                <Border Margin="5,0,0,0" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                    <TextBlock Text="F11" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextTertiary}"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- 分隔竖线 + 系统风格窗口按钮 -->
                        <Border Width="1" Height="16" Background="{DynamicResource Brush.Border}" Margin="6,0,4,0" VerticalAlignment="Center"/>

                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption}"
                                Click="OnMinimizeClick"
                                ToolTip="{x:Static app:Strings.WindowMinimize}"
                                AutomationProperties.Name="{x:Static app:Strings.WindowMinimize}">
                            <Path Data="M0 5H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button x:Name="MaximizeButton" WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption}"
                                Click="OnMaximizeClick"
                                ToolTip="{x:Static app:Strings.WindowMaximize}"
                                AutomationProperties.Name="{x:Static app:Strings.WindowMaximize}">
                            <Path x:Name="MaximizeGlyph" Data="M0 0H10V10H0Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.1" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                        <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.Caption.Close}"
                                Click="OnCloseClick"
                                ToolTip="{x:Static app:Strings.CloseButton}"
                                AutomationProperties.Name="{x:Static app:Strings.CloseButton}">
                            <Path Data="M1 1L9 9M9 1L1 9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="10" Height="10" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================= 主台面：左侧边栏 + 右侧列表 ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="228*" MinWidth="208"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="952*" MinWidth="600"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧边栏：暂存箱 + 快捷工具入口 -->
                <Grid Grid.Column="0" Background="{DynamicResource Brush.SurfaceAlt}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="14,12,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static app:Strings.StashBoxLabel}"/>
                        <Button Grid.Column="1" Style="{StaticResource Button.IconOnly}" Width="26" Height="26" MinHeight="26"
                                Command="{Binding NewGroupCommand}"
                                ToolTip="{x:Static app:Strings.NewGroupButton}"
                                AutomationProperties.Name="{x:Static app:Strings.NewGroupButton}">
                            <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z" Fill="{DynamicResource Brush.TextSecondary}" Width="11" Height="11" Stretch="Uniform"/>
                        </Button>
                    </Grid>

                    <ListBox Grid.Row="1" ctrl:WheelScroll.IsEnabled="True" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static app:Strings.NewGroupButton}" Command="{Binding NewGroupCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.TrayNewShelf}" Command="{Binding NewShelfCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.RenameGroupTitle}" Command="{Binding RenameGroupCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static app:Strings.ClearBoxButton}" Command="{Binding ClearCurrentBoxCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.DeleteGroupTitle}" Command="{Binding DeleteGroupCommand}"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="GroupCard" Margin="8,2" CornerRadius="9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                                                <Grid>
                                                    <Border x:Name="ActiveIndicator" Width="3" Height="18" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="2" Background="{DynamicResource Brush.Accent}" Visibility="Collapsed"/>
                                                    <ContentPresenter/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="GroupCard" Property="Background" Value="{DynamicResource Brush.Hover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="GroupCard" Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                                    <Setter TargetName="GroupCard" Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                                    <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupViewModel}">
                                <Grid Margin="12,8,10,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="2,0,8,0">
                                        <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Tertiary}" Text="{Binding SummaryText}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center" Padding="6,2" CornerRadius="{DynamicResource Radius.Pill}"
                                            Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding FileCountText}" FontFamily="{DynamicResource Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 侧栏底部导航：历史、Git 变更、悬浮球、根目录预设、设置、清空全部、关于、GitHub -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="8,6,8,8">
                        <StackPanel>
                            <StackPanel>
                                <Button Style="{StaticResource Button.SidebarNav}" MinHeight="26" Padding="8,3" Command="{Binding OpenHistoryCommand}" ToolTip="{x:Static app:Strings.TrayHistory}" AutomationProperties.Name="{x:Static app:Strings.TrayHistory}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 11h-4v-2h2.5V6h1.5z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.TrayHistory}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.SidebarNav}" MinHeight="26" Padding="8,3" Command="{Binding OpenGitChangesCommand}" ToolTip="{x:Static app:Strings.TrayGitChanges}" AutomationProperties.Name="{x:Static app:Strings.TrayGitChanges}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M6 3v12m0 0a3 3 0 1 0 3 3 3 3 0 0 0-3-3zm0-12a3 3 0 1 0 3 3 3 3 0 0 0-3-3zm12 3a3 3 0 1 0-3 3 3 3 0 0 0 3-3zm-3 3v3a3 3 0 0 1-3 3H9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.TrayGitChanges}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.SidebarNav}" MinHeight="26" Padding="8,3" Command="{Binding OpenFloatingWindowCommand}" ToolTip="{x:Static app:Strings.TrayFloatingWindow}" AutomationProperties.Name="{x:Static app:Strings.TrayFloatingWindow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="11" Height="11" Margin="0,0,8,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.TrayFloatingWindow}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                                <Button Style="{StaticResource Button.SidebarNav}" MinHeight="26" Padding="8,3" Command="{Binding OpenRootPresetsCommand}" ToolTip="{x:Static app:Strings.TrayRootPresets}" AutomationProperties.Name="{x:Static app:Strings.TrayRootPresets}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M3 6h6l2 2h10v11H3z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeLineJoin="Round" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.TrayRootPresets}" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource Button.SidebarNav}" Command="{Binding OpenSettingsCommand}" ToolTip="{x:Static app:Strings.SettingsButton}" AutomationProperties.Name="{x:Static app:Strings.SettingsButton}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Path Grid.Column="0" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="13" Height="13" Margin="0,0,6,0" Stretch="Uniform" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{x:Static app:Strings.SettingsButton}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Button>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource Button.IconOnly}" Width="28" Height="28" MinHeight="28"
                                            Command="{Binding ClearAllBoxesCommand}"
                                            ToolTip="{x:Static app:Strings.ClearAllBoxesTooltip}"
                                            AutomationProperties.Name="{x:Static app:Strings.ClearAllBoxesTooltip}">
                                        <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource Button.IconOnly}" Width="28" Height="28" MinHeight="28"
                                            Command="{Binding OpenAboutCommand}"
                                            ToolTip="{x:Static app:Strings.TrayAbout}"
                                            AutomationProperties.Name="{x:Static app:Strings.TrayAbout}">
                                        <Path Data="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 15h-2v-6h2zm0-8h-2V7h2z" Fill="{DynamicResource Brush.TextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                    <Button Style="{StaticResource Button.IconOnly}" Width="28" Height="28" MinHeight="28"
                                            Command="{Binding OpenGitHubCommand}"
                                            ToolTip="{x:Static app:Strings.GitHubRepoTooltip}"
                                            AutomationProperties.Name="{x:Static app:Strings.GitHubRepoTooltip}">
                                        <Path Data="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.79 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.4-5.26 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z" Fill="{DynamicResource Brush.TextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" Width="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Cursor="SizeWE"
                              FocusVisualStyle="{StaticResource FocusRing}">
                    <GridSplitter.Template>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border Width="1" HorizontalAlignment="Center" SnapsToDevicePixels="True" Background="{DynamicResource Brush.Border}"/>
                            </Grid>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- 右侧内容区：标题与视图切换 + 4 列文件树 + 空态 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 内容区顶部栏：当前箱名称 + 摘要 + 拖出全部 + 清空当前箱 + 视图模式切换 -->
                    <Grid Grid.Row="0" Margin="20,14,16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CompactHeader}" Style="{StaticResource Text.Title}" FontSize="17" TextTrimming="CharacterEllipsis" ToolTip="{Binding CompactHeader}"/>
                            <TextBlock Text="{Binding StatusSummary}" Style="{StaticResource Text.Caption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusSummary}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="WorkbenchDragAllHandle" WindowChrome.IsHitTestVisibleInChrome="True"
                                    Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.Accent}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Control}" Padding="11,5" Margin="0,0,6,0" Cursor="Hand" VerticalAlignment="Center"
                                    ToolTip="{x:Static app:Strings.DragAllTooltip}"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                    PreviewMouseLeftButtonDown="OnDragAllPreviewMouseLeftButtonDown" PreviewMouseMove="OnDragAllPreviewMouseMove"
                                    AutomationProperties.Name="{x:Static app:Strings.DragAllTooltip}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="↗" FontWeight="Bold" FontSize="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}"/>
                                    <TextBlock Text="{x:Static app:Strings.ShelfDragPrompt}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,7,0" Foreground="{DynamicResource Brush.TextPrimary}"/>
                                    <Border Background="{DynamicResource Brush.Accent}" CornerRadius="{DynamicResource Radius.Pill}" Padding="6,1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DragAllBadgeText}" FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Brush.AccentText}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource Button.IconOnly}"
                                    Command="{Binding ClearCurrentBoxCommand}"
                                    ToolTip="{x:Static app:Strings.ClearBoxButton}"
                                    Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                                    Margin="0,0,8,0"
                                    AutomationProperties.Name="{x:Static app:Strings.ClearBoxButton}">
                                <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" Fill="{DynamicResource Brush.TextSecondary}" Width="13" Height="13" Stretch="Uniform"/>
                            </Button>

                            <Border VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="{x:Static app:Strings.ViewModeTree}" GroupName="WorkbenchView" Style="{StaticResource Segment.Option}" IsChecked="{Binding WorkbenchViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=Tree}"/>
                                    <RadioButton Content="{x:Static app:Strings.ViewModeList}" GroupName="WorkbenchView" Style="{StaticResource Segment.Option}" IsChecked="{Binding WorkbenchViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=List}"/>
                                    <RadioButton Content="{x:Static app:Strings.ViewModeSource}" GroupName="WorkbenchView" Style="{StaticResource Segment.Option}" IsChecked="{Binding WorkbenchViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=BySourceFolder}"/>
                                    <RadioButton Content="{x:Static app:Strings.ViewModeIcons}" GroupName="WorkbenchView" Style="{StaticResource Segment.Option}" IsChecked="{Binding WorkbenchViewMode, Converter={StaticResource EnumMatch}, ConverterParameter=Icons}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 四列表头（必须保持 4 列且与 RowCells 对齐） -->
                    <Border Visibility="{Binding IsIconView, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                            x:Name="ListHeader" Grid.Row="1"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,1"
                            Padding="24,7,12,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.ColumnNamePath}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.ColumnSize}" TextAlignment="Right" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.ColumnSourceBranch}"/>
                            <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.ColumnSourceState}"/>
                        </Grid>
                    </Border>

                    <!-- 树 / 列表 / 按来源 视图（统一使用 ItemTree） -->
                    <TreeView Visibility="{Binding IsIconView, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"
                              x:Name="ItemTree"
                              ctrl:WheelScroll.IsEnabled="True"
                              Grid.Row="2"
                              ItemsSource="{Binding WorkbenchRows}"
                              BorderThickness="0"
                              Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Visible"
                              SelectedItemChanged="OnItemTreeSelectedItemChanged"
                              PreviewMouseLeftButtonDown="OnItemTreePreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnItemTreePreviewMouseMove"
                              AllowDrop="True"
                              DragOver="OnItemTreeDragOver"
                              Drop="OnItemTreeDrop">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static app:Strings.MenuOpenSource}" Command="{Binding OpenSourceLocationCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.MenuCopySourcePath}" Command="{Binding CopySourcePathCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.MenuCopyToClipboard}" Command="{Binding CopyToClipboardCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static app:Strings.MenuRefreshSnapshot}" Command="{Binding RefreshSnapshotCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.MenuSetRoot}" Command="{Binding SetRootCommand}"/>
                                <MenuItem Header="{x:Static app:Strings.MenuMoveToGroup}" Command="{Binding MoveToGroupCommand}"/>
                                <Separator/>
                                <MenuItem Header="{x:Static app:Strings.DeleteItemTitle}" Command="{Binding RemoveCommand}"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        <TreeView.Resources>
                            <DataTemplate x:Key="RowCells">
                                <Grid Height="34">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="88"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="116"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 第 0 列：真实系统文件/文件夹图标 + 文件名 + 路径尾 -->
                                    <Grid Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Image Width="16" Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding FileIcon}" Visibility="{Binding FileIcon, Converter={StaticResource NullToVisibility}}"/>
                                            <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource Brush.TextSecondary}" Visibility="{Binding FileIcon, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Data" Value="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter Property="Data" Value="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Grid>

                                        <DockPanel Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSourceMissing}" Value="True">
                                                                <Setter Property="Opacity" Value="0.55"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding PathTail}" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                       MaxWidth="260" Style="{StaticResource Text.Mono}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourcePath}"/>
                                        </DockPanel>
                                    </Grid>

                                    <!-- 第 1 列：等宽右对齐文件大小 -->
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0" Style="{StaticResource Text.Mono}" Text="{Binding SizeText}"/>

                                    <!-- 第 2 列：来源分支胶囊 -->
                                    <Border Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" MaxWidth="112"
                                            Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Control}" Padding="6,2"
                                            Visibility="{Binding HasBranch, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding BranchText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding BranchText}"/>
                                    </Border>

                                    <!-- 第 3 列：状态胶囊（悬停顶层暂存项时切换为快捷操作按钮） -->
                                    <Grid Grid.Column="3" VerticalAlignment="Center">
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding StatusBadgeBackground}" CornerRadius="{DynamicResource Radius.Pill}" Padding="7,2"
                                                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsItemRow}" Value="True"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Opacity" Value="0"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}"/>
                                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Foreground="{Binding StatusBrush}" FontWeight="Medium" Text="{Binding StatusText}"/>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsItemRow}" Value="True"/>
                                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Style="{StaticResource Button.IconOnly}" Width="24" Height="24" MinHeight="24" Margin="0,0,4,0" Focusable="False"
                                                    Command="{Binding DataContext.OpenSourceLocationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding AsItem}"
                                                    ToolTip="{x:Static app:Strings.MenuOpenSource}" AutomationProperties.Name="{x:Static app:Strings.MenuOpenSource}">
                                                <Path Data="M10 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z" Fill="{DynamicResource Brush.TextSecondary}" Width="12" Height="12" Stretch="Uniform"/>
                                            </Button>
                                            <Button Style="{StaticResource Button.IconOnly}" Width="24" Height="24" MinHeight="24" Focusable="False"
                                                    Command="{Binding DataContext.RemoveItemDirectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding AsItem}"
                                                    ToolTip="{x:Static app:Strings.DeleteButton}" AutomationProperties.Name="{x:Static app:Strings.DeleteButton}">
                                                <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" Fill="{DynamicResource Brush.TextSecondary}" Width="10" Height="10" Stretch="Uniform"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:ItemViewModel}">
                                <HierarchicalDataTemplate.ItemsSource>
                                    <MultiBinding Converter="{StaticResource WorkbenchChildren}">
                                        <Binding Path="Children"/>
                                        <Binding Path="DataContext.WorkbenchViewMode" RelativeSource="{RelativeSource AncestorType=TreeView}"/>
                                        <Binding Path="IsFolder"/>
                                    </MultiBinding>
                                </HierarchicalDataTemplate.ItemsSource>
                                <ContentPresenter ContentTemplate="{StaticResource RowCells}"/>
                            </HierarchicalDataTemplate>

                            <DataTemplate DataType="{x:Type vm:EntryViewModel}">
                                <ContentPresenter ContentTemplate="{StaticResource RowCells}"/>
                            </DataTemplate>

                            <HierarchicalDataTemplate DataType="{x:Type vm:SourceFolderRowViewModel}" ItemsSource="{Binding Children}">
                                <Grid Height="28">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Directory}" Style="{StaticResource Text.Caption}" FontWeight="SemiBold" MaxWidth="520" TextTrimming="CharacterEllipsis" ToolTip="{Binding Directory}" VerticalAlignment="Center"/>
                                        <Border Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center" Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Pill}">
                                            <TextBlock Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextTertiary}" Text="{Binding FileCountText}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <!-- 图标平铺视图 -->
                    <ListBox x:Name="IconList" Grid.Row="2" Style="{StaticResource ShelfItems}"
                             ItemsSource="{Binding FilteredItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             ContextMenu="{StaticResource ShelfMenu}"
                             Visibility="{Binding IsIconView, Converter={StaticResource BoolToVisibility}}"
                             PreviewMouseLeftButtonDown="OnCompactPreviewMouseLeftButtonDown"
                             PreviewMouseMove="OnCompactPreviewMouseMove"/>

                    <!-- 搜索无结果空态 -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSearchNoMatches, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{x:Static app:Strings.SearchNoMatches}" Style="{StaticResource Text.Title}" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                        <Button Margin="0,12,0,0" HorizontalAlignment="Center" Content="{x:Static app:Strings.ClearSearchTooltip}" Command="{Binding ClearSearchCommand}"/>
                    </StackPanel>

                    <!-- 空台面：托盘货架风格空态引导 -->
                    <Border Grid.Row="2" Margin="28,20" CornerRadius="{DynamicResource Radius.Panel}" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="OnEmptyShelfClick" ToolTip="{x:Static app:Strings.AddButton}"
                            Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVisibility}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20,16">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource ShelfFileStackGlyph}" Width="58" Height="58" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="0,0,22,0" VerticalAlignment="Center"/>
                                <StackPanel Width="380" VerticalAlignment="Center">
                                    <TextBlock HorizontalAlignment="Left" Style="{StaticResource Text.Title}" FontWeight="SemiBold" FontSize="15.5" Foreground="{DynamicResource Brush.TextPrimary}" Text="{x:Static app:Strings.WorkbenchEmptyTitle}"/>
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Left" Style="{StaticResource Text.Caption}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Text="{x:Static app:Strings.WorkbenchEmptyHint}"/>
                                    <Button Margin="0,14,0,0" HorizontalAlignment="Left" Style="{StaticResource Button.Primary}" Command="{Binding AddItemsCommand}" Content="{x:Static app:Strings.AddButton}"/>
                                </StackPanel>
                            </StackPanel>
                        </Viewbox>
                    </Border>
                </Grid>
            </Grid>

            <!-- ================= 底部写回工作栏 ================= -->
            <Border Grid.Row="2" Style="{StaticResource ActionBar}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.ColumnSpan="3">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,6">
                                <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.WriteBackLabel}"/>
                                <Border Background="{DynamicResource Brush.SurfaceSunken}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Control}" Padding="3">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="{x:Static app:Strings.TargetOriginal}" GroupName="Target" Style="{StaticResource Segment.Option}" IsChecked="{Binding TargetMode, Converter={StaticResource EnumMatch}, ConverterParameter=OriginalLocation}"/>
                                        <RadioButton Content="{x:Static app:Strings.TargetAnotherRoot}" GroupName="Target" Style="{StaticResource Segment.Option}" IsChecked="{Binding TargetMode, Converter={StaticResource EnumMatch}, ConverterParameter=AnotherRoot}"/>
                                        <RadioButton Content="{x:Static app:Strings.TargetSpecifiedPath}" GroupName="Target" Style="{StaticResource Segment.Option}" IsChecked="{Binding TargetMode, Converter={StaticResource EnumMatch}, ConverterParameter=SpecifiedPath}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.StructureLabel}"/>
                                <ComboBox Width="126" Margin="6,0,0,0" ItemsSource="{Binding Structures}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{x:Static app:Strings.StructureLabel}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Structure, Mode=TwoWay}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,6" VerticalAlignment="Center">
                                <TextBlock Margin="8,0,6,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.ConflictLabel}"/>
                                <ComboBox Width="96" ItemsSource="{Binding Policies}" ToolTip="{Binding SelectedItem.Label, RelativeSource={RelativeSource Self}}" AutomationProperties.Name="{x:Static app:Strings.ConflictLabel}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ConflictPolicy, Mode=TwoWay}"/>
                            </StackPanel>
                        </WrapPanel>

                        <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,4,0,2" VerticalAlignment="Center" Visibility="{Binding HasTargetPath, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource Button.Picker}" ToolTip="{x:Static app:Strings.BrowseTargetTooltip}" AutomationProperties.Name="{x:Static app:Strings.BrowseTargetTooltip}" Command="{Binding BrowseTargetPathCommand}"/>
                        </Grid>
                    </Grid>

                    <!-- 落点预览 + 主操作按钮 -->
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding WillWriteCaption}" Visibility="{Binding HasDestination, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{x:Static app:Strings.NothingToWrite}" Visibility="{Binding HasDestination, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Mono.Primary.Gap}" Text="{Binding DestinationPreview}" TextTrimming="CharacterEllipsis" Visibility="{Binding HasDestination, Converter={StaticResource BoolToVisibility}}" ToolTip="{Binding DestinationPreview}"/>
                        </Grid>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Content="{x:Static app:Strings.UndoLastButton}" Command="{Binding UndoLastCommand}" Style="{StaticResource Button.Ghost}"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Content="{x:Static app:Strings.PreviewButton}" Margin="8,0,0,0" Command="{Binding PreviewCommand}"/>
                            <Button WindowChrome.IsHitTestVisibleInChrome="True" Content="{x:Static app:Strings.ApplyButton}" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Command="{Binding ApplyCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- 批量任务进度 -->
                    <Grid Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Width="150" Height="4" Minimum="0" Maximum="1" VerticalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Border}" BorderThickness="0" Value="{Binding ProgressValue, Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" Text="{Binding StatusText}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= 拖拽悬停反馈 ================= -->
        <Border x:Name="DropOverlay" Visibility="Collapsed" Opacity="0" Margin="1" CornerRadius="{DynamicResource Radius.Panel}" BorderThickness="0" Background="{DynamicResource Brush.ShelfSurface}" RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Rectangle Margin="14" RadiusX="12" RadiusY="12" Stroke="{DynamicResource Brush.Accent}" Opacity="0.88" StrokeThickness="1.5" StrokeDashArray="4,4" StrokeDashCap="Round"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ContentControl ContentTemplate="{StaticResource ShelfFileStackGlyph}" Width="56" Height="56" Margin="0,0,0,14"/>
                    <TextBlock Text="{x:Static app:Strings.DropToStashPrompt}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Brush.ShelfText}" TextAlignment="Center" TextWrapping="Wrap" Margin="26,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
