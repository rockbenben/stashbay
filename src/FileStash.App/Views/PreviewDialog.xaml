<Window x:Class="FileStash.App.Views.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileStash.App.Converters"
        xmlns:local="clr-namespace:FileStash.App.Views"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.PreviewTitle}"
        Width="940"
        Height="560"
        MinWidth="680"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}"
        FontFamily="{DynamicResource Font.UI}"
        FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:EnumLabelConverter x:Key="EnumLabel" />
        <conv:ByteSizeConverter x:Key="ByteSize" />

        <!-- 状态列：只有"根本写不进去"的那两档需要被看见，其余保持安静 -->
        <Style x:Key="Cell.State" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="TypeConflict">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Invalid">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Cell.Path" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <!-- 路径被截断时，全长得在 tooltip 里看得到 -->
            <Setter Property="ToolTip" Value="{Binding TargetPath}" />
        </Style>

        <Style x:Key="Cell.Size" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Cell.Warning" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Warning}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 目标说明 -->
        <Border Grid.Row="0" Padding="18,14,18,12">
            <StackPanel>
                <TextBlock x:Name="TargetText" Style="{StaticResource Text.Title}"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="GitText"
                           Margin="0,4,0,0"
                           Style="{StaticResource Text.Caption}"
                           Foreground="{DynamicResource Brush.Warning}"
                           Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- 统计 -->
        <Border Grid.Row="1"
                Margin="18,0,18,10"
                Padding="12,8"
                Background="{DynamicResource Brush.SurfaceAlt}"
                CornerRadius="{DynamicResource Radius.Panel}">
            <TextBlock x:Name="SummaryText" Style="{StaticResource Text.Caption}" />
        </Border>

        <!-- 明细 -->
        <DataGrid x:Name="EntryGrid"
                  Grid.Row="2"
                  Margin="18,0,18,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:Strings.ColumnStatus}"
                                    Binding="{Binding State, Converter={StaticResource EnumLabel}}"
                                    ElementStyle="{StaticResource Cell.State}"
                                    Width="92"
                                    IsReadOnly="True" />

                <!-- 这一行属于哪个暂存项：数据一直在计划里（ItemDisplayName），以前没列出来 -->
                <DataGridTextColumn Header="{x:Static app:Strings.ColumnSourceItem}"
                                    Binding="{Binding ItemDisplayName}"
                                    Width="150"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="ToolTip" Value="{Binding ItemDisplayName}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="{x:Static app:Strings.ColumnTargetPath}"
                                    Binding="{Binding TargetPath}"
                                    ElementStyle="{StaticResource Cell.Path}"
                                    Width="*"
                                    IsReadOnly="True" />

                <!-- 大小走与主界面同一套格式化：以前这里绑的是裸字节 -->
                <DataGridTextColumn Header="{x:Static app:Strings.ColumnSize}"
                                    Binding="{Binding Source.Size, Converter={StaticResource ByteSize}}"
                                    ElementStyle="{StaticResource Cell.Size}"
                                    Width="78"
                                    IsReadOnly="True" />

                <DataGridTemplateColumn Header="{x:Static app:Strings.ColumnAction}" Width="112">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- 只有需要决定的行才给下拉，其余行显示文字 -->
                                <ComboBox ItemsSource="{x:Static local:ApplyActions.Items}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Action, Mode=TwoWay}"
                                          MinHeight="24"
                                          Padding="6,2,6,2"
                                          Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Action, Converter={StaticResource EnumLabel}}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           Style="{StaticResource Text.Body}"
                                           Visibility="{Binding NeedsDecision, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="{x:Static app:Strings.ColumnWarning}"
                                    Binding="{Binding Warning}"
                                    ElementStyle="{StaticResource Cell.Warning}"
                                    Width="180"
                                    IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部 -->
        <Border Grid.Row="3" Margin="0,14,0,0" Style="{StaticResource ActionBar}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static app:Strings.CompareDiffButton}" Click="OnCompareDiff" />
                    <ProgressBar x:Name="Progress"
                                 Width="160"
                                 Height="4"
                                 Margin="12,0,0,0"
                                 VerticalAlignment="Center"
                                 IsIndeterminate="True"
                                 Visibility="Collapsed" />
                    <TextBlock x:Name="ProgressText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.Caption}" />
                </StackPanel>

                <StackPanel Style="{StaticResource Actions.End}">
                    <Button Content="{x:Static app:Strings.CancelButton}" IsCancel="True" x:Name="CancelButton" Click="OnCancel" />
                    <Button Content="{x:Static app:Strings.ApplyButton}"
                            Margin="8,0,0,0"
                            Style="{StaticResource Button.Primary}"
                            x:Name="ExecuteButton"
                            Click="OnExecute" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
