<Window x:Class="FileStash.App.Views.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.AppName}"
        Width="96"
        Height="96"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!--
        悬浮球：拖进来就暂存，点击或短拖展开紧凑暂存台。
    -->
    <Border x:Name="Panel"
            Width="86"
            Height="86"
            CornerRadius="43"
            Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.Accent}"
            BorderThickness="2"
            MouseLeftButtonDown="OnMouseLeftButtonDown"
            DragEnter="OnDragEnter"
            DragLeave="OnDragLeave"
            Cursor="SizeAll"
            ToolTip="{x:Static app:Strings.DropToStashHint}"
            AllowDrop="True"
            Drop="OnDrop"
            DragOver="OnDragOver">
        <Border.ContextMenu>
            <ContextMenu>
                <MenuItem Header="{x:Static app:Strings.TrayHideFloatingWindow}" Click="OnHideClick"/>
            </ContextMenu>
        </Border.ContextMenu>
        <StackPanel VerticalAlignment="Center" IsHitTestVisible="False">
            <TextBlock Text="{x:Static app:Strings.AppName}"
                       HorizontalAlignment="Center"
                       FontSize="9.5"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Accent}" />
            <TextBlock x:Name="CountText"
                       HorizontalAlignment="Center"
                       FontSize="22"
                       FontWeight="Bold"
                       Margin="0,1,0,0"
                       RenderTransformOrigin="0.5,0.5"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="0">
                <TextBlock.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
