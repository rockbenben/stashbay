<Window x:Class="FileStash.App.Views.GitStatusDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.GitStatusTitle}"
        Width="640"
        Height="520"
        MinWidth="420"
        MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="RepoText"
                   Grid.Row="0"
                   Style="{StaticResource Text.Caption}"
                   TextTrimming="CharacterEllipsis" />

        <ListView Grid.Row="1"
                  Margin="0,10,0,0"
                  ItemsSource="{Binding Items}"
                  SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected}"
                                  IsEnabled="{Binding CanSelect}" />

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   Text="{Binding StatusText}" />

                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   Text="{Binding Path}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="2"
                   Margin="0,8,0,0"
                   Style="{StaticResource Text.Caption}"
                   Text="{Binding StatusText}" />

        <StackPanel Grid.Row="3"
                    Margin="0,12,0,0"
                    Style="{StaticResource Actions.End}">
            <Button Content="{x:Static app:Strings.RefreshButton}" Command="{Binding LoadCommand}" />
            <Button Content="{x:Static app:Strings.AddSelectedButton}"
                    Margin="6,0,0,0"
                    Style="{StaticResource Button.Primary}"
                    Command="{Binding AddSelectedCommand}" />
            <Button Content="{x:Static app:Strings.CloseButton}" Margin="6,0,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
