<Window x:Class="FileStash.App.Views.RootPresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.RootPresetsTitle}"
        Icon="pack://application:,,,/Resources/app.ico"
        Width="520"
        Height="420"
        MinWidth="360"
        MinHeight="280"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">

    <Window.Resources>
        <!--
            格子里的文字要能截断：DataGrid 的列宽是 * 或 2*，有界；
            不给 TextTrimming 的话长路径与长名字会直接冲出格子，
            压在隔壁列上（阿拉伯语下从左边冲出去，窗边裁掉的是路径开头）。
        -->
        <Style x:Key="Cell.Trimmed" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Presets}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="Transparent"
                  BorderBrush="{DynamicResource Brush.Border}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{x:Static app:Strings.ColumnName}"
                                    Binding="{Binding Name}"
                                    Width="*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                            <Setter Property="ToolTip" Value="{Binding Name}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="{x:Static app:Strings.ColumnPath}"
                                    Binding="{Binding Path}"
                                    Width="2*"
                                    IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Cell.Trimmed}">
                            <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                            <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
                            <Setter Property="ToolTip" Value="{Binding Path}" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- DeleteCommand 一直在，只是没有落点：预设能建能看，删不掉 -->
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="{x:Static app:Strings.DeleteButton}"
                                    Style="{StaticResource Button.Ghost}"
                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
                    Margin="0,12,0,0"
                    Style="{StaticResource Actions.End}">
            <Button Content="{x:Static app:Strings.NewPresetButton}" Command="{Binding AddCommand}" Style="{StaticResource Button.Primary}" />
            <Button Content="{x:Static app:Strings.CloseButton}" Margin="6,0,0,0" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
