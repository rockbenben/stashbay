<Window x:Class="FileStash.App.Views.Dialogs.GroupPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Title="{x:Static app:Strings.MoveToGroupTitle}"
        Width="320"
        Height="150"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Surface}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Text.Caption}"
                   Text="{x:Static app:Strings.ChooseTargetGroup}" />

        <ComboBox x:Name="GroupBox"
                  Grid.Row="1"
                  Margin="0,8,0,0"
                  DisplayMemberPath="Name"
                  SelectedValuePath="Id" />

        <StackPanel Grid.Row="2"
                    Margin="0,16,0,0"
                    Style="{StaticResource Actions.End}">
            <Button Content="{x:Static app:Strings.OkButton}"
                    IsDefault="True"
                    Click="OnConfirm"
                    Style="{StaticResource Button.Primary}" />
            <Button Content="{x:Static app:Strings.CancelButton}"
                    IsCancel="True"
                    Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
