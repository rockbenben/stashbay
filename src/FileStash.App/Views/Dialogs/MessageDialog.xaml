<Window x:Class="FileStash.App.Views.Dialogs.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:FileStash.App.Resources"
        Width="480" MinWidth="320" SizeToContent="Height" MaxHeight="392"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{DynamicResource Font.UI}" FontSize="{DynamicResource Font.Size.Body}"
        UseLayoutRounding="True" KeyDown="OnKeyDown">
    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1" CornerRadius="12">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           Style="{StaticResource Text.Title}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button Grid.Column="1" Style="{StaticResource Button.Ghost}" Width="28" Height="28" Padding="0"
                        ToolTip="{x:Static app:Strings.CloseButton}" AutomationProperties.Name="{x:Static app:Strings.CloseButton}" Click="OnClose">
                    <Path Data="M4 4L16 16M16 4L4 16" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" Margin="0,16,0,24" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
            </ScrollViewer>
            <WrapPanel Grid.Row="2" HorizontalAlignment="Right">
                <Button x:Name="CancelAction" Content="{x:Static app:Strings.CancelButton}" Margin="0,0,8,0" Click="OnClose" />
                <Button x:Name="AcceptAction" Content="{x:Static app:Strings.OkButton}" Style="{StaticResource Button.Primary}" Click="OnAccept" />
            </WrapPanel>
        </Grid>
    </Border>
</Window>
