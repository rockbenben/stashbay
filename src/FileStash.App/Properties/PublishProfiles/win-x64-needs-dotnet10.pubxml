<Project>

  <!--
    框架依赖单文件（win-x64）：体积小得多，但用户要先装 .NET 10 运行时。
    只把 SelfContained 改成 false，另外两行必须删掉：
    · EnableCompressionInSingleFile 传给框架依赖会以 NETSDK1176 直接失败；
    · IncludeNativeLibrariesForSelfExtract 在这个 bundle 里没有原生库可打包，
      它不报错，所以会一直躺着误导人。
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>none</DebugType>
    <!-- 别把 pdb 打进发布产物 -->
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>bin\Release\publish-x64-needs-dotnet10\</PublishDir>
  </PropertyGroup>

</Project>
